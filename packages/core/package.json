{
  "name": "nuikit-core",
  "version": "0.6.0",
  "description": "The runtime behind nuikit, one design system for your whole FiveM server: typed fetchNui and events, surfaces (focus, layers, Escape across resources), the theme compiler (tokens v1, DTCG) and browser devtools.",
  "author": "belibathan (https://github.com/belibathan)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "fivem",
    "nui",
    "cfx",
    "redm",
    "react",
    "shadcn",
    "gta",
    "roleplay",
    "qbcore",
    "qbox",
    "esx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/belibathan/nuikit",
    "directory": "packages/core"
  },
  "homepage": "https://nuikit.vercel.app",
  "files": [
    "dist",
    "lua",
    "tokens",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./tokens.json": "./tokens/nuikit.tokens.json",
    "./theme.schema.json": "./tokens/nuikit-theme.schema.json",
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/export-tokens.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wasmoon": "^1.16.0"
  },
  "bugs": "https://github.com/belibathan/nuikit/issues"
}
