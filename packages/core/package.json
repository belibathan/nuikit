{
  "name": "nuikit-core",
  "version": "0.8.0",
  "description": "The runtime behind nuikit, one design system for your whole FiveM server: typed fetchNui and events, surfaces (focus, layers, Escape across resources), the theme compiler (tokens v1, DTCG) and browser devtools.",
  "author": "belibathan (https://github.com/belibathan)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "fivem",
    "nui",
    "cfx",
    "redm",
    "react",
    "shadcn",
    "gta",
    "roleplay",
    "qbcore",
    "qbox",
    "esx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/belibathan/nuikit",
    "directory": "packages/core"
  },
  "homepage": "https://nuikit.vercel.app",
  "files": [
    "dist",
    "lua",
    "arsenal.json",
    "src/spec",
    "tokens",
    "fonts",
    "themes",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./tokens.json": "./tokens/nuikit.tokens.json",
    "./fonts/*": "./fonts/*",
    "./themes/*": "./themes/*",
    "./theme.schema.json": "./tokens/nuikit-theme.schema.json",
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "import": "./dist/coverage.js"
    },
    "./intents": {
      "types": "./dist/intents.d.ts",
      "import": "./dist/intents.js"
    },
    "./intents-react": {
      "types": "./dist/intents-react.d.ts",
      "import": "./dist/intents-react.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces.d.ts",
      "import": "./dist/surfaces.js"
    },
    "./camera": {
      "types": "./dist/camera.d.ts",
      "import": "./dist/camera.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "import": "./dist/images.js"
    },
    "./zones": {
      "types": "./dist/zones.d.ts",
      "import": "./dist/zones.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "import": "./dist/slots.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    }
  },
  "scripts": {
    "intents": "node scripts/gen-intents.mjs",
    "build": "node scripts/gen-intents.mjs && node scripts/arsenal.mjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/export-tokens.mjs",
    "arsenal": "node scripts/arsenal.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wasmoon": "^1.16.0"
  },
  "bugs": "https://github.com/belibathan/nuikit/issues"
}
