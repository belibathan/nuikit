        "components": [
          0.8314,
          0.8314,
          0.8314
        ],
        "alpha": 1,
        "hex": "#d4d4d4"
      },
      "$description": "The server's signature colour: active indicators, gauge needles, focus, logos (not the action: that's primary)"
