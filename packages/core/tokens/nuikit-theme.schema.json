{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuikit.vercel.app/schema/theme.v1.json",
  "title": "nuikit compiled theme (tokens v1)",
  "description": "What compileTheme() returns and the nuikit resource publishes: every token, lowered so FiveM's browser can read it.",
  "type": "object",
  "required": [
    "version",
    "vars"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "hash": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vars": {
      "type": "object",
      "required": [
        "background",
        "foreground",
        "card",
        "card-foreground",
        "popover",
        "popover-foreground",
        "primary",
        "primary-foreground",
        "secondary",
        "secondary-foreground",
        "muted",
        "muted-foreground",
        "accent",
        "accent-foreground",
        "destructive",
        "destructive-foreground",
        "border",
        "input",
        "ring",
        "chart-1",
        "chart-2",
        "chart-3",
        "chart-4",
        "chart-5",
        "radius",
        "font-sans",
        "font-mono",
        "success",
        "success-foreground",
        "warning",
        "warning-foreground",
        "info",
        "info-foreground",
        "hud",
        "hud-foreground",
        "vital-health",
        "vital-armor",
        "vital-hunger",
        "vital-thirst",
        "vital-stress",
        "nk-scale",
        "nk-motion"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Full-screen surfaces (pause, loading, death scrim)"
        },
        "foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on full-screen surfaces"
        },
        "card": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Raised blocks on a full-screen surface"
        },
        "card-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on cards"
        },
        "popover": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Every floating panel (nk-panel)"
        },
        "popover-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text in panels"
        },
        "primary": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "The one main action per surface, progress fills, selection"
        },
        "primary-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on primary"
        },
        "secondary": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Secondary buttons"
        },
        "secondary-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on secondary"
        },
        "muted": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Tracks, slots and wells inside a panel"
        },
        "muted-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Secondary text"
        },
        "accent": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Hover and keyboard highlight"
        },
        "accent-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on accent"
        },
        "destructive": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Danger, damage, low values, death"
        },
        "destructive-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on destructive"
        },
        "border": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Hairlines"
        },
        "input": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Field borders"
        },
        "ring": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Focus rings"
        },
        "chart-1": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Categorical colour 1"
        },
        "chart-2": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Categorical colour 2"
        },
        "chart-3": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Categorical colour 3"
        },
        "chart-4": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Categorical colour 4"
        },
        "chart-5": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Categorical colour 5"
        },
        "radius": {
          "type": "string",
          "description": "Corner radius (panels radius + 4px, controls radius − 2px)"
        },
        "font-sans": {
          "type": "string",
          "description": "Text"
        },
        "font-mono": {
          "type": "string",
          "description": "Codes and IDs a player might type"
        },
        "success": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Positive status: done, paid, online"
        },
        "success-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on success"
        },
        "warning": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Caution status: low fuel, about to expire"
        },
        "warning-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on warning"
        },
        "info": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Neutral status: tips, notices"
        },
        "info-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text on info"
        },
        "hud": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Surfaces drawn straight on the game: HUD chips, hotbar, target eye"
        },
        "hud-foreground": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Text and icons on hud"
        },
        "vital-health": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Health bar"
        },
        "vital-armor": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Armor bar"
        },
        "vital-hunger": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Hunger bar"
        },
        "vital-thirst": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Thirst bar"
        },
        "vital-stress": {
          "type": "string",
          "pattern": "^rgba?\\(",
          "description": "Stress bar"
        },
        "nk-scale": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "UI size multiplier (unitless). Players can scale further (0.85–1.25)."
        },
        "nk-motion": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "1 = animations on, 0 = off. Players can turn motion off."
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
