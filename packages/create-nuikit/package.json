{
  "name": "create-nuikit",
  "version": "0.1.0",
  "description": "Scaffold a FiveM NUI resource with shadcn/ui, Tailwind v4, typed Lua↔JS and browser devtools — that renders right in game.",
  "license": "MIT",
  "type": "module",
  "bin": { "create-nuikit": "./dist/index.js" },
  "files": ["dist", "template"],
  "keywords": ["fivem", "nui", "create", "scaffold", "shadcn", "tailwindcss", "vite", "react", "redm", "qbcore", "qbox", "esx"],
  "repository": { "type": "git", "url": "https://github.com/belibathan/nuikit", "directory": "packages/create-nuikit" },
  "homepage": "https://github.com/belibathan/nuikit#readme",
  "scripts": {
    "prebuild": "node ../../scripts/sync-template.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/node": "^22.10.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
