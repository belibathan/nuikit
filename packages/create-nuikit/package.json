{
  "name": "create-nuikit",
  "version": "0.6.0",
  "description": "Start a FiveM NUI resource on nuikit: stock shadcn/ui, the nuikit kit and theme, typed Lua↔React and browser devtools.",
  "author": "belibathan (https://github.com/belibathan)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-nuikit": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "keywords": [
    "fivem",
    "nui",
    "create",
    "scaffold",
    "shadcn",
    "tailwindcss",
    "vite",
    "react",
    "redm",
    "qbcore",
    "qbox",
    "esx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/belibathan/nuikit",
    "directory": "packages/create-nuikit"
  },
  "homepage": "https://nuikit.vercel.app",
  "scripts": {
    "prebuild": "node ../../scripts/sync-template.mjs",
    "build": "tsup && node scripts/templates.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/node": "^22.10.0",
    "nuikit-core": "workspace:*",
    "picocolors": "^1.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wasmoon": "^1.16.0"
  },
  "bugs": "https://github.com/belibathan/nuikit/issues"
}
