{
  "name": "vite-plugin-nuikit",
  "version": "0.7.0",
  "description": "Make stock shadcn/ui and Tailwind v4 render right in FiveM's Chromium 103 NUI. Part of nuikit, one design system for your whole FiveM server.",
  "author": "belibathan (https://github.com/belibathan)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "fivem",
    "nui",
    "vite-plugin",
    "tailwindcss",
    "tailwind-v4",
    "shadcn",
    "oklch",
    "color-mix",
    "cef",
    "chromium-103",
    "redm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/belibathan/nuikit",
    "directory": "packages/vite"
  },
  "homepage": "https://nuikit.vercel.app",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "nuikit-doctor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "browserslist": "^4.24.0",
    "css-has-pseudo": "^8.0.2",
    "lightningcss": "^1.29.0",
    "postcss": "^8.5.30"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "bugs": "https://github.com/belibathan/nuikit/issues"
}
