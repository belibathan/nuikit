  "description": "Make shadcn/ui and Tailwind v4 render in FiveM's Chromium 103 NUI, plus in-game hot reload.",
  "license": "MIT",
  "type": "module",
  "keywords": ["fivem", "nui", "vite-plugin", "tailwindcss", "tailwind-v4", "shadcn", "oklch", "color-mix", "cef", "chromium-103", "redm"],
