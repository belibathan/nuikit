{
  "name": "nuikit-host-web",
  "private": true,
  "version": "0.5.0",
  "description": "The nuikit resource's frame: the host for other resources' UI modules, and the default renderers for the intents (docs/intents.md).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p .",
