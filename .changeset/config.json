{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [
    [
      "nuikit-core",
      "vite-plugin-nuikit",
      "create-nuikit",
      "@belibathan/nuikit"
    ]
  ],
  "access": "public",
  "baseBranch": "main",
  "ignore": [
    "cef-proof",
    "nuikit-hud-web",
    "www"
  ],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}-{datetime}"
  }
}
