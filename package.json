{
  "name": "nuikit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm registry:build && pnpm --filter www build && pnpm build:systems",
    "dev": "pnpm --filter www dev",
    "test": "pnpm -r --filter \"./packages/**\" --filter www test",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter www --filter \"./systems/**\" typecheck",
    "registry:build": "shadcn build -o apps/www/public/r",
    "proof": "pnpm --filter cef-proof proof",
    "changeset": "changeset",
    "build:systems": "pnpm -r --filter \"./systems/**\" --filter \"./addons/**\" build",
    "pack:systems": "node scripts/pack-systems.mjs",
    "sync": "node scripts/sync-template.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "shadcn": "^4.22.0",
    "typescript": "^5.6.3"
  }
}
