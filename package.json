{
  "name": "nuikit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm registry:build && pnpm --filter www build && pnpm build:systems",
    "dev": "pnpm --filter www dev",
    "test": "pnpm -r --filter \"./packages/**\" --filter www test",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter www --filter \"./systems/**\" typecheck",
    "registry:build": "shadcn build -o apps/www/public/r",
    "proof": "pnpm --filter cef-proof proof",
    "visual": "node bench/visual/run.mjs",
    "visual:update": "node bench/visual/run.mjs --update",
    "look": "node bench/visual/run.mjs --look",
    "changeset": "changeset",
    "build:systems": "pnpm -r --filter \"./systems/**\" --filter \"./addons/**\" build",
    "pack:systems": "node scripts/pack-systems.mjs",
    "sync": "node scripts/sync-template.mjs",
    "check:burndown": "node scripts/check-burndown.mjs",
    "lint:classes": "eslint registry systems addons --report-unused-disable-directives-severity off -f ./scripts/eslint-github.cjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.8.0",
    "playwright-core": "1.56.0",
    "shadcn": "^4.22.0",
    "tailwind-merge": "^3.0.0",
    "typescript": "^5.6.3"
  }
}
