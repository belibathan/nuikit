{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/components/ui/*": [
        "../../registry/nuikit/ui/*",
        "../../vendor/shadcn/ui/*"
      ],
      "@/hooks/*": [
        "../../registry/nuikit/hooks/*",
        "../../vendor/shadcn/hooks/*"
      ],
      "@/blocks/*": [
        "../../registry/nuikit/blocks/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "nuikit-core/motion": [
        "./node_modules/nuikit-core/dist/motion.d.ts"
      ],
      "nuikit-core/react": [
        "./node_modules/nuikit-core/dist/react.d.ts"
      ],
      "nuikit-core": [
        "./node_modules/nuikit-core/dist/index.d.ts"
      ],
      "sonner": [
        "./node_modules/sonner/dist/index.d.ts"
      ],
      "radix-ui": [
        "./node_modules/radix-ui"
      ],
      "class-variance-authority": [
        "./node_modules/class-variance-authority"
      ],
      "next-themes": [
        "./node_modules/next-themes"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "clsx": [
        "./node_modules/clsx"
      ],
      "tailwind-merge": [
        "./node_modules/tailwind-merge"
      ],
      "vitest": [
        "./node_modules/vitest"
      ]
    }
  },
  "include": [
    "src",
    "../../registry"
  ]
}
